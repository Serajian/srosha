# ==================================================================================== #
# srosha — console only
# ==================================================================================== #
# Read after .env. The console serves the pages people sign in to -- the
# customer portal and the admin surface, two listeners in one process -- and
# sends one kind of message: a sign-in code, straight over SMTP.
#
# It has no broker, no sending credentials and no callback secrets. Do not add
# any: this is the one binary that is exposed to the internet.
# ==================================================================================== #

# Where the pages are served. Public.
NOTIF_PORTAL_ADDR=:8090

# /healthz only, and deliberately a different port: the one above is public.
NOTIF_HTTP_ADDR=:8091

# Where the admin pages are served. Never published -- bound to the loopback
# interface by default (127.0.0.1, not :8092) so staying off the network is a
# property of the process, not only a deployment fact. In production the console
# REFUSES TO START unless this binds loopback: a safe default is not a guard.
NOTIF_ADMIN_ADDR=127.0.0.1:8092

# How many rows one panel listing shows: the queue, all sources, a source's
# message log, a source's own decisions, the roster, the audit feed -- one
# number for all of them, because it is the same concept everywhere it
# appears. A listing that hits this cap says so on the page rather than
# silently showing a partial answer as if it were everything.
NOTIF_ADMIN_LIST_LIMIT=200

# ------------------------------------------------------------------ sign-in mail
# The console's own mail account, not the sender's. Signing in must not depend on
# how a customer's messages happen to be configured, and the two are changed by
# different people for different reasons.
#
# It does NOT go through srosha's queue. That is the point: a sign-in that
# depends on the service you are signing in to fix is a trap.
NOTIF_CONSOLE_SMTP_HOST=
NOTIF_CONSOLE_SMTP_PORT=587
NOTIF_CONSOLE_SMTP_USER=
NOTIF_CONSOLE_SMTP_PASSWORD=

# What a person sees in "From", which is not always the account above.
NOTIF_CONSOLE_SMTP_FROM=

# How long one code may take to hand over.
NOTIF_CONSOLE_SMTP_TIMEOUT=15s

# ------------------------------------------------------------------ cookies
# Off only for local development over plain http. A session cookie without it
# travels in the clear, so production refuses to start with it off.
NOTIF_CONSOLE_SECURE_COOKIE=true

# ------------------------------------------------------------------ sealing
# The console seals a customer's sending credential when they register one, and
# issues a callback's signing secret. Same keyring the gateway and dispatcher
# use -- see docs/ARCHITECTURE.md on why holding the key to seal is holding the
# key to open, and why that is accepted rather than overlooked.
NOTIF_CRYPTO_KEYS=
NOTIF_CRYPTO_KEY_ID=

# ------------------------------------------------------------------ callbacks
# What a customer may register as a callback address. Both off in production: a
# signature over plain http protects nothing, and a private address lets a
# customer point srosha at something inside our network.
NOTIF_WEBHOOK_ALLOW_INSECURE_URL=false
NOTIF_WEBHOOK_ALLOW_PRIVATE_URL=false
