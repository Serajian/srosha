# ==================================================================================== #
# srosha — shared by both binaries
# ==================================================================================== #
# Each binary reads this file first, then its own: .env.gateway or .env.dispatcher.
# Neither has to exist. In production the platform supplies the variables and no
# file is there; anything already set always wins over a file.
#
# Copy to .env and fill in. .env is git-ignored; this file never holds a real value.
#
# PASSWORDS: letters, digits and hyphens only. A "#" is truncated by Dokploy's .env
# parsing, ")" "!" "$" break in the shell, and "#" "@" ":" "/" "?" need
# percent-encoding inside a connection url. Generate with: openssl rand -hex 24
# ==================================================================================== #

NOTIF_APP_ENV=development
NOTIF_APP_SERVICE_NAME=srosha
NOTIF_APP_SHUTDOWN_TIMEOUT=15s

# Required. In production the host is the compose service name on the private
# network, never a Dokploy container name.
NOTIF_DB_DSN=postgres://srosha:CHANGE-ME@postgres:5432/srosha?sslmode=disable
NOTIF_DB_MAX_CONNS=10
NOTIF_DB_MAX_LIFETIME=30m

# Required. Each binary connects as its OWN nats user; never share one credential.
#   gateway    may publish notify.> and $JS.API.>, and subscribe to _INBOX.> only
#   dispatcher may publish $JS.API.> and $JS.ACK.>, and subscribe to _INBOX.> and notify.>
NOTIF_MQ_URL=nats://gateway:CHANGE-ME@nats:4222
NOTIF_MQ_STREAM=NOTIFY

# How long the broker remembers a message id. Recovery republishes a delivery it
# is not sure about, and this window is what makes that safe.
NOTIF_MQ_DUPLICATE_WINDOW=1h

NOTIF_TELEMETRY_LOG_LEVEL=info
