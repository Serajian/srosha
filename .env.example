# ==================================================================================== #
# srosha — environment
# ==================================================================================== #
# Configuration is environment-only; there is no config file. Keys are read through
# viper with the prefix NOTIF_ and "." in a config key mapped to "_".
#
# Copy to .env and fill in. .env is git-ignored; this file never holds a real value.
#
# PASSWORDS: letters, digits and hyphens only. A "#" is truncated by Dokploy's .env
# parsing, and ")" "!" "$" break in the shell, and "#" "@" ":" "/" "?" need
# percent-encoding inside a connection URL. Generate with: openssl rand -hex 24
# ==================================================================================== #

# ------------------------------------------------------------------ app (both binaries)
NOTIF_APP_ENV=development
NOTIF_APP_SERVICE_NAME=srosha
NOTIF_APP_SHUTDOWN_TIMEOUT=15s

# ------------------------------------------------------------------ gateway only
# gRPC listener, and the REST listener served by grpc-gateway (also /healthz).
NOTIF_GRPC_ADDR=:50051
NOTIF_GRPC_HTTP_ADDR=:8080
NOTIF_RATELIMIT_PER_MINUTE=600

# ------------------------------------------------------------------ dispatcher only
# Minimal HTTP listener, /healthz only.
NOTIF_HTTP_ADDR=:8081

# ------------------------------------------------------------------ database (both)
# In production the host is the compose service name on the private network, never a
# Dokploy container name: postgres:5432, database srosha, role srosha.
NOTIF_DB_DSN=postgres://srosha:CHANGE-ME@postgres:5432/srosha?sslmode=disable
NOTIF_DB_MAX_CONNS=10
NOTIF_DB_MAX_LIFETIME=30m

# ------------------------------------------------------------------ message queue (both)
# Each binary uses its OWN nats user. Never share one credential between them:
#   gateway    may publish notify.> and $JS.API.>, and subscribe to _INBOX.> only
#   dispatcher may publish $JS.API.> and $JS.ACK.>, and subscribe to _INBOX.> and notify.>
NOTIF_MQ_URL=nats://gateway:CHANGE-ME@nats:4222

# ------------------------------------------------------------------ senders (dispatcher only)
NOTIF_SENDER_SMTP_HOST=
NOTIF_SENDER_SMTP_PORT=587
NOTIF_SENDER_SMTP_USER=
NOTIF_SENDER_SMTP_PASSWORD=
NOTIF_SENDER_TELEGRAM_TOKEN=
NOTIF_SENDER_BALE_TOKEN=
NOTIF_SENDER_WHATSAPP_TOKEN=

# ------------------------------------------------------------------ webhooks (dispatcher only)
NOTIF_WEBHOOK_TIMEOUT=10s
NOTIF_WEBHOOK_MAX_ATTEMPTS=5

# ------------------------------------------------------------------ telemetry (both)
NOTIF_TELEMETRY_LOG_LEVEL=info

# ------------------------------------------------------------------ goose (migrations)
# Migrations are a separate deployment step, never run from an application entrypoint.
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=migrations
GOOSE_DBSTRING=postgres://srosha:CHANGE-ME@postgres:5432/srosha?sslmode=disable
