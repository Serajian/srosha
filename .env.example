# ==================================================================================== #
# srosha — shared by every binary
# ==================================================================================== #
# There are four: gateway, dispatcher, console and migrate. Each reads this file
# first, then its own -- .env.gateway, .env.dispatcher, .env.console. None has to
# exist. In production the platform supplies the variables and no file is there;
# anything already set always wins over a file.
#
# Everything below the shared block is grouped by which binary reads it. Keeping
# it in one file rather than four is deliberate: a key nobody can find is a key
# somebody sets in the wrong place. Which binary needs what is also the table in
# docs/CONFIG.md, and the two must agree.
#
# Copy to .env and fill in. .env is git-ignored; this file never holds a real value.
#
# PASSWORDS: letters, digits and hyphens only. A "#" is truncated by Dokploy's .env
# parsing, ")" "!" "$" break in the shell, and "#" "@" ":" "/" "?" need
# percent-encoding inside a connection url. Generate with: openssl rand -hex 24
# ==================================================================================== #

NOTIF_APP_ENV=development
NOTIF_APP_SERVICE_NAME=srosha
NOTIF_APP_SHUTDOWN_TIMEOUT=15s

# Required. In production the host is the compose service name on the private
# network, never a Dokploy container name.
NOTIF_DB_DSN=postgres://srosha:CHANGE-ME@postgres:5432/srosha?sslmode=disable
NOTIF_DB_MAX_CONNS=10
NOTIF_DB_MAX_CONN_LIFETIME=30m
NOTIF_DB_MAX_CONN_IDLE_TIME=5m

# How often the pool notices a connection died under it.
NOTIF_DB_HEALTH_CHECK_PERIOD=30s

# One attempt, and the loop that covers a database container still starting up.
# Past this the fault is real and crash-looping is the honest answer.
NOTIF_DB_CONNECT_TIMEOUT=5s
NOTIF_DB_CONNECT_ATTEMPTS=5
NOTIF_DB_CONNECT_BACKOFF=2s

# Required, and read by BOTH binaries. These open the sending credentials a
# source registers -- a bot token, an smtp password -- which are stored encrypted
# because they have to be handed to a provider and so must come back out.
#
# A SET of keys, not one, because changing the key is a when and not an if. Each
# stored value names the key that produced it, so rotation is: add the new key,
# point KEY_ID at it, and let old values reseal themselves as they are read. No
# step stops the service, and the old key is dropped once no value names it.
#
# 32 bytes, standard base64. Generate with: openssl rand -base64 32
#
# NEVER commit a real one, and never let a database dump and this file meet:
# together they are the plaintext.
NOTIF_CRYPTO_KEYS={"1":"CHANGE-ME-32-BYTES-BASE64"}

# Which key in that set new values are sealed with. Old values name their own.
NOTIF_CRYPTO_KEY_ID=1

# Required. Each binary connects as its OWN nats user; never share one credential.
#   gateway    may publish notify.> and $JS.API.>, and subscribe to _INBOX.> only
#   dispatcher may publish $JS.API.> and $JS.ACK.>, and subscribe to _INBOX.> and notify.>
NOTIF_MQ_URL=nats://gateway:CHANGE-ME@nats:4222
NOTIF_MQ_STREAM=NOTIFY

# How long the broker remembers a message id. A publish that reached the broker
# but whose acknowledgement was lost is retried with the same delivery id, and
# this window is what stops one delivery going out twice.
#
# It is NOT what makes recovery safe: recovery sends rather than republishing.
# See docs/ARCHITECTURE.md.
NOTIF_MQ_DUPLICATE_WINDOW=1h

# A backstop on a stream nobody is draining. It is not what keeps a delayed
# delivery correct -- recovery reads rows, not events -- so it only has to be
# comfortably longer than the duplicate window.
NOTIF_MQ_MAX_AGE=24h

# One dial, and how long the process waits at startup for the broker to answer.
NOTIF_MQ_CONNECT_TIMEOUT=10s

# What nats does on its own after the first connection. -1 is forever, which is
# what a long-running service wants: a broker restart must not need ours.
NOTIF_MQ_MAX_RECONNECTS=-1
NOTIF_MQ_RECONNECT_WAIT=2s

# How long a handler gets to finish what it is holding before the connection is
# closed under it. Keep it at or below NOTIF_APP_SHUTDOWN_TIMEOUT.
NOTIF_MQ_DRAIN_TIMEOUT=15s

# What the dispatcher calls OUT with -- the webhook callbacks and the provider
# APIs. Not NOTIF_HTTP_ADDR, which is its own listener.
NOTIF_HTTP_CLIENT_TIMEOUT=30s
NOTIF_HTTP_CLIENT_DIAL_TIMEOUT=5s
NOTIF_HTTP_CLIENT_TLS_TIMEOUT=5s
NOTIF_HTTP_CLIENT_MAX_IDLE_CONNS=100

# Go's own default here is 2, which with a hundred sources means dialing again
# on almost every callback.
NOTIF_HTTP_CLIENT_MAX_IDLE_PER_HOST=10
NOTIF_HTTP_CLIENT_IDLE_CONN_TIMEOUT=90s

# How the listeners behave. Where each one listens is in the per-binary file:
# NOTIF_GRPC_HTTP_ADDR for the gateway, NOTIF_HTTP_ADDR for the dispatcher.
#
# READ_HEADER_TIMEOUT is the one that matters for safety: without it a client can
# hold a connection open by sending headers a byte at a time.
NOTIF_HTTP_SERVER_READ_HEADER_TIMEOUT=5s
NOTIF_HTTP_SERVER_READ_TIMEOUT=15s
NOTIF_HTTP_SERVER_WRITE_TIMEOUT=15s
NOTIF_HTTP_SERVER_IDLE_TIMEOUT=60s

# How strict the callback address check is. BOTH binaries read these: the
# gateway validates the address a source registers, and the dispatcher checks it
# again after DNS -- a name that passed the first check can still resolve onto
# our own network.
#
# Both MUST be false in production: they are what stops a source pointing us at
# our own network. Loading refuses to start if either is on with APP_ENV=production.
NOTIF_WEBHOOK_ALLOW_INSECURE_URL=false
NOTIF_WEBHOOK_ALLOW_PRIVATE_URL=false

NOTIF_TELEMETRY_LOG_LEVEL=info

# Left unset on purpose: the default follows NOTIF_APP_ENV -- json in
# production, where a collector parses it, and text everywhere else, where a
# person reads it. Set it only to override that.
# NOTIF_TELEMETRY_LOG_FORMAT=text

# File and line on every record. Worth turning on while chasing something; it
# costs real time at volume.
NOTIF_TELEMETRY_LOG_SOURCE=false


# ==================================================================================== #
# gateway
# ==================================================================================== #

# The customer API. Reached at api.srosha.ir through Traefik, which speaks h2c
# to it: grpc is http/2 and nothing in the path may downgrade it.
NOTIF_GRPC_ADDR=:50051

# Its own /healthz and /readyz. A second listener on purpose -- readiness must
# answer when the surface it reports on is the broken thing.
NOTIF_GRPC_HTTP_ADDR=:8080

# How long calls in flight get once shutdown starts.
NOTIF_GRPC_STOP_TIMEOUT=10s

# How often a used api key writes its last-used stamp. Not every request: that
# would be a write on the hot path to answer a question nobody asks per second.
NOTIF_AUTH_KEY_TOUCH_AFTER=1h

# What one source may submit per minute. A token bucket, so the number is also
# the burst -- a source that has been quiet may spend it at once.
NOTIF_RATELIMIT_PER_MINUTE=600

# ==================================================================================== #
# dispatcher
# ==================================================================================== #

# How many times the broker may hand one delivery over before it is dead-lettered,
# and how long a handler has before the broker decides it did not answer.
NOTIF_DISPATCH_MAX_ATTEMPTS=5
NOTIF_DISPATCH_ACK_WAIT=1m
NOTIF_DISPATCH_MAX_IN_FLIGHT=50

# Recovery: deliveries the broker was never told about, or was told about and
# dropped. Age is the retry counter -- nothing is written when a send fails
# transiently -- so the gap between these two decides how many attempts a row
# gets. Five minutes and thirty is roughly six.
NOTIF_RECONCILE_AFTER=5m
NOTIF_RECONCILE_GIVE_UP=30m
NOTIF_RECONCILE_SCHEDULE=@every 5m
NOTIF_RECONCILE_BATCH=100

# How long one sweep owns the rows it claimed. It covers ONE case: a dispatcher
# that died holding them. A send that merely failed hands the row straight back.
NOTIF_RECONCILE_LEASE=10m

# The callback to a source. A courtesy, so waiting on a slow one must not hold up
# the delivery that triggered it -- and a callback that keeps failing is switched
# off rather than retried forever.
NOTIF_WEBHOOK_TIMEOUT=10s
NOTIF_WEBHOOK_MAX_FAILURES=20

# ==================================================================================== #
# dispatcher — srosha's OWN sending identities, one per channel
# ==================================================================================== #
# These are the FALLBACK: what a source sends as when it has registered nothing
# of its own. A channel left empty is not a startup failure -- a delivery asking
# for it fails as NO_SENDER and the source is told, rather than the whole service
# staying down.
#
# The console reads NONE of these, and that absence is a boundary rather than an
# omission: it builds its registry with an empty fallback, so a customer's trial
# can never quietly succeed by sending as srosha. See docs/ARCHITECTURE.md.

NOTIF_SENDER_SMTP_HOST=
NOTIF_SENDER_SMTP_PORT=587
NOTIF_SENDER_SMTP_USER=
NOTIF_SENDER_SMTP_PASSWORD=
NOTIF_SENDER_SMTP_FROM=

NOTIF_SENDER_TELEGRAM_TOKEN=
NOTIF_SENDER_BALE_TOKEN=

# Meta identifies the sending number separately from the account that owns it.
NOTIF_SENDER_WHATSAPP_TOKEN=
NOTIF_SENDER_WHATSAPP_PHONE_NUMBER_ID=

# Matrix is federated, so there is no homeserver that is right for everybody.
NOTIF_SENDER_MATRIX_TOKEN=
NOTIF_SENDER_MATRIX_HOMESERVER=

# Gotify is self-hosted, so the server is not a constant either. The token is
# what selects the application -- there is no application id key and there should
# not be, see docs/CONFIG.md.
NOTIF_SENDER_GOTIFY_TOKEN=
NOTIF_SENDER_GOTIFY_SERVER_URL=

# A whole service-account json, base64 of the FILE. Google does not hand out
# tokens: this is exchanged for one. The encoding is an environment concern only
# -- a source registering its own sends the file itself.
NOTIF_SENDER_FCM_SERVICE_ACCOUNT=

# The p8 signing key, base64 of the file, and the three names that go with it.
# Only the key is secret: the key id names the file, the team id names the
# account, and the topic is the app's bundle id, which ships inside every copy of
# the app. Environment is "production" or "development".
NOTIF_SENDER_APNS_KEY=
NOTIF_SENDER_APNS_KEY_ID=
NOTIF_SENDER_APNS_TEAM_ID=
NOTIF_SENDER_APNS_TOPIC=
NOTIF_SENDER_APNS_ENVIRONMENT=

# ==================================================================================== #
# gateway + dispatcher — how long a message is kept
# ==================================================================================== #
# srosha is not an archive. Both read the age: the gateway refuses to answer a
# question about a window it has already deleted, and the dispatcher does the
# deleting.
NOTIF_RETENTION_AGE=720h
NOTIF_RETENTION_SCHEDULE=0 3 * * *
NOTIF_RETENTION_BATCH=1000

# ==================================================================================== #
# console
# ==================================================================================== #
# Two surfaces in one process, on three listeners, behind two hostnames. Each
# surface brings its own address, because which of them is exposed is the whole
# security argument.

# panel.srosha.ir -- the customer portal. Public.
NOTIF_PORTAL_ADDR=:8090

# admin.srosha.ir -- the operator panel. Public too, deliberately.
#
# Loopback here is a DEFAULT and nothing more: right for a laptop, wrong in a
# container, where loopback is the container's own namespace and reaches nothing
# at all. Deployed, this listens like any other service and Traefik routes to it
# by host. Nothing checks the value -- what keeps a customer out is a cookie
# scoped to that host and a role read from the live row on every request.
NOTIF_ADMIN_ADDR=127.0.0.1:8092

# How many rows one panel listing shows. One key for all of them, because it is
# one concept -- separate keys per page would drift apart with nothing to notice.
NOTIF_ADMIN_LIST_LIMIT=200

# Required: the mail account sign-in codes go out through. Its OWN, not the
# sender's -- signing in must not depend on how a customer's messages happen to
# be configured, and a sign-in that goes through the service you are signing in
# to fix is a trap.
NOTIF_CONSOLE_SMTP_HOST=
NOTIF_CONSOLE_SMTP_PORT=587
NOTIF_CONSOLE_SMTP_USER=
NOTIF_CONSOLE_SMTP_PASSWORD=
NOTIF_CONSOLE_SMTP_FROM=
NOTIF_CONSOLE_SMTP_TIMEOUT=15s

# Off only for local development over plain http. A cookie without it travels in
# the clear, and the console refuses to start in production with it off.
NOTIF_CONSOLE_SECURE_COOKIE=true

# The senders page has a button that really sends a test message. Without a cap
# it is a way to make srosha's server send as fast as somebody can click.
#
# NOT the source's sending quota and it cannot be: the gateway's limiter is a
# separate bucket in a separate process, so a test costs a customer no message.
# Zero is refused -- a cap of zero is the button broken forever.
NOTIF_CONSOLE_TRIAL_PER_MINUTE=3

# ==================================================================================== #
# every binary — the operator's own alerts
# ==================================================================================== #
# Both Gotify values empty means alerts are off, which is every laptop. Set, they
# carry what an operator has to act on: every audited change, whether each binary
# came up, and a dependency going down or coming back.
#
# It does NOT go through srosha's own pipeline. An alert that travelled the path
# it reports on would be silent exactly when it matters, so the alerter holds its
# own http client and reaches Gotify directly.
NOTIF_ALERT_GOTIFY_SERVER_URL=
NOTIF_ALERT_GOTIFY_TOKEN=

# How many alerts may wait before one is dropped. Dropping is the point: an alert
# must never block or break the thing it is reporting on.
NOTIF_ALERT_QUEUE=64

# One push. Nothing waits on it.
NOTIF_ALERT_TIMEOUT=10s

# How often a binary asks itself whether its dependencies are there. It reports
# only on a CHANGE -- down, and back -- never the state.
NOTIF_ALERT_READY_EVERY=30s

# ==================================================================================== #
# migrate
# ==================================================================================== #
# A fourth binary, and it reads almost nothing: APP_ENV, DB_DSN, the telemetry
# keys, and this. No broker, no crypto keys, no sending credentials -- a tool that
# runs before the service starts should not need the service's secrets.
#
# Every deploy runs it, and two deploys can land together. This is how long the
# second waits on the first's advisory lock before giving up.
NOTIF_MIGRATION_LOCK_TIMEOUT=5m
