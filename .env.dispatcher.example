# ==================================================================================== #
# srosha — dispatcher only
# ==================================================================================== #
# Read after .env. The dispatcher sends and calls back, so this is where the
# provider credentials and the signing secrets live.
# ==================================================================================== #

# /healthz only.
NOTIF_HTTP_ADDR=:8081

# ------------------------------------------------------------------ senders
# srosha's own credentials, used when a source has not brought its own. Leave a
# channel empty if it is not in use: a delivery on it then fails as NO_SENDER and
# is reported to the source, rather than keeping the service down.
NOTIF_SENDER_SMTP_HOST=
NOTIF_SENDER_SMTP_PORT=587
NOTIF_SENDER_SMTP_USER=
NOTIF_SENDER_SMTP_PASSWORD=
NOTIF_SENDER_SMTP_FROM=
NOTIF_SENDER_TELEGRAM_TOKEN=
NOTIF_SENDER_BALE_TOKEN=
NOTIF_SENDER_WHATSAPP_TOKEN=

# ------------------------------------------------------------------ callbacks
# One signing secret per source, keyed by source id. A single shared secret would
# let any source holding it forge a signed callback to another. Handed to the
# source out of band; never stored and never returned by the API.
NOTIF_WEBHOOK_SECRETS={"acme":"CHANGE-ME","shop":"CHANGE-ME"}

NOTIF_WEBHOOK_TIMEOUT=10s

# Failures in a row before a callback is switched off, so a dead endpoint is not
# called once for every message from then on.
NOTIF_WEBHOOK_MAX_FAILURES=20

# ------------------------------------------------------------------ dispatch
# Must match the stream's MaxDeliver. Higher, and the broker gives up first,
# leaving the row pending with no outcome written on it.
NOTIF_DISPATCH_MAX_ATTEMPTS=5

# How long the broker waits for an acknowledgement before it decides nobody
# handled the message and gives it to somebody else. It must be longer than the
# slowest send: shorter, and a provider that takes its time gets the same
# message twice.
NOTIF_DISPATCH_ACK_WAIT=60s

# How many deliveries are worked on at once, which is this binary's concurrency.
# Unbounded, a full queue would open hundreds of connections to one provider at
# the same moment.
NOTIF_DISPATCH_MAX_IN_FLIGHT=50

# How long a delivery may sit pending before recovery picks it up, and the age
# past which its next attempt is its last. The gap between them is what decides
# how many attempts a stranded row gets.
NOTIF_RECONCILE_AFTER=5m
NOTIF_RECONCILE_GIVE_UP=30m
# When recovery sweeps. A cron spec or an interval descriptor -- one parser
# reads both, so "*/5 * * * *" and "0 3 * * *" work here too. Read in UTC, so a
# schedule means the same moment wherever this runs. One second is the finest
# interval; anything shorter is rounded up to it.
NOTIF_RECONCILE_SCHEDULE=@every 5m
NOTIF_RECONCILE_BATCH=100

# How long a delivery stays the dispatcher that took it. Recovery sends directly
# rather than republishing, so the broker cannot stop two dispatchers sending the
# same row -- taking it exclusively is what can, and this is how long that lasts.
#
# It covers ONE case: a dispatcher that died holding a row. A send that merely
# failed hands the row straight back. So set it from the slowest send there could
# be, never from how often recovery runs -- and it must be longer than
# NOTIF_DISPATCH_ACK_WAIT, or a second dispatcher can take a row the first is
# still sending.
NOTIF_RECONCILE_LEASE=10m
