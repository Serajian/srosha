# ==================================================================================== #
# srosha — dispatcher only
# ==================================================================================== #
# Read after .env. The dispatcher sends and calls back, so this is where the
# provider credentials and the signing secrets live.
# ==================================================================================== #

# /healthz only.
NOTIF_HTTP_ADDR=:8081

# ------------------------------------------------------------------ senders
# srosha's own credentials, used when a source has not brought its own. Leave a
# channel empty if it is not in use: a delivery on it then fails as NO_SENDER and
# is reported to the source, rather than keeping the service down.
NOTIF_SENDER_SMTP_HOST=
NOTIF_SENDER_SMTP_PORT=587
NOTIF_SENDER_SMTP_USER=
NOTIF_SENDER_SMTP_PASSWORD=
NOTIF_SENDER_SMTP_FROM=
NOTIF_SENDER_TELEGRAM_TOKEN=
NOTIF_SENDER_BALE_TOKEN=

# Matrix is federated, so there is no homeserver that is right for everybody the
# way there is one api.telegram.org. Both are needed, and the address must be
# https: an access token over plain http is a token in the clear.
NOTIF_SENDER_MATRIX_TOKEN=
NOTIF_SENDER_MATRIX_HOMESERVER=

# Gotify is self-hosted, so there is no server that is right for everybody the
# way there is one api.telegram.org. Both are needed, and the address must be
# https: the application token travels as a query parameter, not a header, so
# it would be a token in the clear over plain http.
NOTIF_SENDER_GOTIFY_TOKEN=
NOTIF_SENDER_GOTIFY_SERVER_URL=
# The Firebase service account key file, base64 of the whole json. Encoded
# because it is multi-line json with a PEM key inside it, and .env files,
# compose files and secret managers each mangle that differently:
#   base64 -i service-account.json | tr -d '\n'
# The project id is inside the file, so there is nothing else to set. A source
# registering its own sends the json itself, not the base64.
NOTIF_SENDER_FCM_SERVICE_ACCOUNT=

# The APNs signing key, base64 of the .p8 file. Encoded for the same reason as
# the one above -- it is a PEM key and .env files mangle newlines:
#   base64 -i AuthKey_ABC123.p8 | tr -d '\n'
# The other three are not secret: the key id is in the filename, the team id is
# the developer account, and the topic is the app's bundle id. The environment
# is production or sandbox and defaults to production -- they are separate
# services with separate device tokens, and a token from one is unknown to the
# other.
NOTIF_SENDER_APNS_KEY=
NOTIF_SENDER_APNS_KEY_ID=
NOTIF_SENDER_APNS_TEAM_ID=
NOTIF_SENDER_APNS_TOPIC=
NOTIF_SENDER_APNS_ENVIRONMENT=production

NOTIF_SENDER_WHATSAPP_TOKEN=

# Meta identifies the sending number separately from the account that owns it:
# the id goes in the url, the token in a header. Both are needed, and this is an
# id they issue -- not the phone number.
NOTIF_SENDER_WHATSAPP_PHONE_NUMBER_ID=

# ------------------------------------------------------------------ callbacks
# There is no signing secret here. It used to be a json map of source id to
# secret, which made every new source a redeploy; it lives in the database now,
# sealed, and is issued on the call that registers a callback.

NOTIF_WEBHOOK_TIMEOUT=10s

# Failures in a row before a callback is switched off, so a dead endpoint is not
# called once for every message from then on.
NOTIF_WEBHOOK_MAX_FAILURES=20

# ------------------------------------------------------------------ dispatch
# Must match the stream's MaxDeliver. Higher, and the broker gives up first,
# leaving the row pending with no outcome written on it.
NOTIF_DISPATCH_MAX_ATTEMPTS=5

# How long the broker waits for an acknowledgement before it decides nobody
# handled the message and gives it to somebody else. It must be longer than the
# slowest send: shorter, and a provider that takes its time gets the same
# message twice.
NOTIF_DISPATCH_ACK_WAIT=60s

# How many deliveries are worked on at once, which is this binary's concurrency.
# Unbounded, a full queue would open hundreds of connections to one provider at
# the same moment.
NOTIF_DISPATCH_MAX_IN_FLIGHT=50

# How long a delivery may sit pending before recovery picks it up, and the age
# past which its next attempt is its last. The gap between them is what decides
# how many attempts a stranded row gets.
NOTIF_RECONCILE_AFTER=5m
NOTIF_RECONCILE_GIVE_UP=30m
# When recovery sweeps. A cron spec or an interval descriptor -- one parser
# reads both, so "*/5 * * * *" and "0 3 * * *" work here too. Read in UTC, so a
# schedule means the same moment wherever this runs. One second is the finest
# interval; anything shorter is rounded up to it.
NOTIF_RECONCILE_SCHEDULE=@every 5m
NOTIF_RECONCILE_BATCH=100

# How long a delivery stays the dispatcher that took it. Recovery sends directly
# rather than republishing, so the broker cannot stop two dispatchers sending the
# same row -- taking it exclusively is what can, and this is how long that lasts.
#
# It covers ONE case: a dispatcher that died holding a row. A send that merely
# failed hands the row straight back. So set it from the slowest send there could
# be, never from how often recovery runs -- and it must be longer than
# NOTIF_DISPATCH_ACK_WAIT, or a second dispatcher can take a row the first is
# still sending.
NOTIF_RECONCILE_LEASE=10m

# ------------------------------------------------------------------ retention
# srosha is not an archive. A message and its deliveries answer "what happened to
# this", and past some age nobody asks -- so keeping them is a table that only
# grows, and slower queries for everyone who does ask.
#
# Deliveries have no age of their own: the foreign key takes them with the
# message, so there is one number here and not two that could disagree.
#
# The sweep deletes by AGE ALONE, with no check that the deliveries settled. That
# is safe only while a delivery gives up long before a message is dropped -- it
# gives up in minutes, so one still pending a month later is a row recovery never
# saw, not work waiting to happen. Loading refuses an age under 24x
# NOTIF_RECONCILE_GIVE_UP for exactly that reason.
NOTIF_RETENTION_AGE=720h

# When the sweep runs. Nightly at an hour somebody chose rather than every-so-
# many-hours, because a heavy job should not be tied to when the process last
# restarted. Same parser as NOTIF_RECONCILE_SCHEDULE.
NOTIF_RETENTION_SCHEDULE=0 3 * * *

# How many messages one statement deletes. An unbounded DELETE over a table that
# has been collecting for a year is a single transaction holding locks on all of
# it. A run repeats until nothing older is left.
NOTIF_RETENTION_BATCH=1000
