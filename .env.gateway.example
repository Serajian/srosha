# ==================================================================================== #
# srosha — gateway only
# ==================================================================================== #
# Read after .env. The gateway accepts requests; it never sends anything, so it has
# no sender credentials and no callback secrets, and must not be given any.
# ==================================================================================== #

NOTIF_GRPC_ADDR=:50051
NOTIF_GRPC_HTTP_ADDR=:8080

# Requests per minute per source. This is the quota Admit spends.
NOTIF_RATELIMIT_PER_MINUTE=600
