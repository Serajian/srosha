# ==================================================================================== #
# srosha — gateway only
# ==================================================================================== #
# Read after .env. The gateway accepts requests; it never sends anything, so it has
# no sender credentials and no callback secrets, and must not be given any.
# ==================================================================================== #

NOTIF_GRPC_ADDR=:50051
NOTIF_GRPC_HTTP_ADDR=:8080

# How long a graceful stop waits for the calls in flight before cutting them.
# The gRPC server is the first thing to close and everything below it in the
# shutdown order is waiting, so keep this under NOTIF_APP_SHUTDOWN_TIMEOUT.
NOTIF_GRPC_STOP_TIMEOUT=10s

# Requests per minute per source. This is the quota Admit spends.
NOTIF_RATELIMIT_PER_MINUTE=600

# How stale last_used_at on an API key may get. Every authenticated request
# would otherwise carry an UPDATE, and "when was this key last used" does not
# need answering to the minute.
NOTIF_AUTH_KEY_TOUCH_AFTER=1h
