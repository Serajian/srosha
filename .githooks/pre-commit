#!/usr/bin/env bash
# The checks live in the Makefile, so this hook and `make precommit` can never
# disagree. Skip once with: git commit --no-verify
set -uo pipefail

RED='\033[31m'; YELLOW='\033[33m'; RESET='\033[0m'

staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

if printf '%s\n' "$staged" | grep -q '\.go$'; then
   if ! make --no-print-directory precommit; then
      printf "${RED}pre-commit failed. Run 'make fix', or bypass with --no-verify.${RESET}\n"
      exit 1
   fi
fi

# --- policy warnings, never blocking: both have legitimate exceptions -------
if [ "$(git rev-parse --abbrev-ref HEAD)" = "master" ]; then
   printf "${YELLOW}⚠  committing straight onto master; conventions expect a <type>/<slug> branch${RESET}\n"
fi

# docs/CONVENTIONS.md: every change to this repository produces a report.
if printf '%s\n' "$staged" | grep -qv '^docs/' \
   && ! printf '%s\n' "$staged" | grep -q '^docs/changes/[0-9]'; then
   printf "${YELLOW}⚠  no docs/changes/ report staged — the rule says one goes in this commit${RESET}\n"
fi
